# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS web
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/package.json
RUN npm install
COPY apps/web apps/web
RUN npm run build:web

FROM node:22-slim AS opencli
RUN npm install -g @jackwener/opencli@1.8.6 \
    && opencli --version

FROM python:3.12-slim AS api
WORKDIR /app
RUN printf '%s\n' \
        'Acquire::ForceIPv4 "true";' \
        'Acquire::Retries "1";' \
        'Acquire::http::Timeout "20";' \
        'Acquire::https::Timeout "20";' \
        'Acquire::http::Pipeline-Depth "0";' \
        > /etc/apt/apt.conf.d/99codex-network \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain 1.94.1
COPY Cargo.toml Cargo.lock* ./
COPY apps/api/Cargo.toml apps/api/Cargo.toml
COPY apps/api apps/api
RUN --mount=type=cache,id=infofetcher-cargo-registry-v1,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=infofetcher-api-target-v1,target=/app/target,sharing=locked \
    touch apps/api/src/main.rs \
    && cargo build --release -p infofetcher-api \
    && mkdir -p /out \
    && cp /app/target/release/infofetcher-api /out/infofetcher-api

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=api /out/infofetcher-api /usr/local/bin/infofetcher-api
COPY --from=web /app/apps/web/dist /app/apps/web/dist
COPY --from=opencli /usr/local/bin/node /usr/local/bin/node
COPY --from=opencli /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/@jackwener/opencli/dist/src/main.js /usr/local/bin/opencli
ENV WEB_DIST_DIR=/app/apps/web/dist
EXPOSE 8080
CMD ["infofetcher-api", "serve"]
