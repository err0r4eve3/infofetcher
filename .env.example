DATABASE_URL=postgres://infofetcher:reader@localhost:5432/infofetcher
APP_BIND=0.0.0.0:8080
APP_PUBLIC_URL=http://localhost:8080
ADMIN_USERNAME=admin
AUTH_TOKEN=
# 可选：只读服务凭据，仅可访问 /api/v2/intel/*（TradingAgents 等外部服务用 Bearer 调用）；32–256 个无空白 ASCII 字符，不能与 AUTH_TOKEN 相同。
INTEL_API_TOKEN=
COOKIE_SECURE=false
SESSION_DAYS=14
CONTENT_RETENTION_DAYS=365
INDEX_DIR=./data/tantivy
FETCH_CONCURRENCY=16
FETCH_INTERVAL_MINUTES=30
FEED_MAX_BYTES=5242880
ARTICLE_MAX_BYTES=8388608
ALLOW_PRIVATE_FETCH=false
# 事件层向量召回（本机 llama.cpp，OpenAI 兼容 /v1/embeddings）；留空则关闭
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=embeddinggemma-2
LLM_BASE_URL=https://cpa1.cat-infra.com/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CONCURRENCY=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_CONTEXT_BUDGET_CHARS=64000
EVENT_AGENT_ENABLED=false
EVENT_AGENT_INTERVAL_SECONDS=30
EVENT_AGENT_LOOKBACK_HOURS=24
EVENT_AGENT_MAX_PENDING=12
EVENT_AGENT_UPDATE_DEBOUNCE_SECONDS=1800
TRANSLATION_BASE_URL=https://cpa1.cat-infra.com/v1
TRANSLATION_API_KEY=
TRANSLATION_MODEL=claude-haiku-5-5
TRANSLATION_TIMEOUT_SECONDS=60
TRANSLATION_MAX_CONCURRENCY=2
TRANSLATION_MAX_INPUT_CHARS=60000
TRANSLATION_CHUNK_CHARS=6000
TRANSLATION_MAX_OUTPUT_TOKENS=8192
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=20
ARTICLE_FETCH_COOKIES_JSON={}
OPENCLI_BIN=opencli
OPENCLI_TIMEOUT_SECONDS=90
OPENCLI_MAX_CONCURRENCY=1
OPENCLI_ACCESS_TOKEN=
# 无需登录的示例：{"bluesky-bsky-app":{"title":"Bluesky · bsky.app","link":"https://bsky.app/profile/bsky.app","args":["bluesky","user","bsky.app","--limit","20"]}}
# X 和 Bilibili 登录抓取使用聚合或单创作者白名单，完整配置见 deploy/opencli-feeds.json。
OPENCLI_FEEDS_JSON={}
RSSHUB_BASE_URL=
HOST_RSSHUB_PORT=11200
WEB_WATCHES_JSON={}
WEBSUB_ENABLED=false
WEBSUB_LEASE_SECONDS=604800
BROWSER_FETCH_ENABLED=false
BROWSER_FETCH_BIN=chromium
BROWSER_FETCH_USER_DATA_DIR=
BROWSER_FETCH_TIMEOUT_SECONDS=45
BROWSER_FETCH_WAIT_MS=5000

# 编辑层（docs/EDITORIAL_LAYER.md）
EDITORIAL_ENABLED=false
EDITORIAL_INTERVAL_SECONDS=600
EDITORIAL_DAILY_EVENT_LIMIT=600
EDITORIAL_THRESHOLDS=world-news:5,tech-research:5,long-read:5
BRIEF_SECTION_SHARES=world:0.45,technology:0.3,business:0.3,security:0.2,general:0.25
BRIEF_EDITION_HOUR=8
BRIEF_EDITION_UTC_OFFSET_HOURS=8
# 设置后开放 /feeds/brief.xml?token=…（32–256 位随机串）
BRIEF_FEED_TOKEN=
BRIEF_WEBHOOK_URL=
BRIEF_WEBHOOK_FORMAT=generic
BRIEF_TELEGRAM=false
# 设置后开放 POST /mcp（Authorization: Bearer …）
MCP_API_TOKEN=
